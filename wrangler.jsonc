{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quotientquest",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-28",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quotientquest",
      "database_id": "aef24ab7-c351-46e8-b384-eaae65f1f905",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
    { "name": "SIGN_UP_LIMITER", "namespace_id": "4202", "simple": { "limit": 40, "period": 60 } }
  ],
  "secrets": { "required": ["CODE_PEPPER", "CODE_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "HUB_WORLD", "class_name": "HubWorld" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HubWorld"] }]
}
