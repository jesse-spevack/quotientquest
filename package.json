{
  "name": "quotientquest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply quotientquest --local",
    "db:migrate:remote": "wrangler d1 migrations apply quotientquest --remote",
    "types": "wrangler types src/server/worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p src/server && tsc -p test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "types:check": "wrangler types src/server/worker-configuration.d.ts --check"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "phaser": "4.2.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
